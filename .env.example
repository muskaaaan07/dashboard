# ——— Option A: Local Node server (direct MongoDB connection) ———
# Server (do not use in browser). Used by: npm run server
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Tell the frontend to use the local /api (run server with: npm run server)
VITE_USE_MONGODB_SERVER=true

# ——— Option B: Atlas Data API (no server, client calls Atlas directly) ———
# See DATA_API_SETUP.md for how to get URL and key.
# VITE_MONGODB_DATA_API_URL=
# VITE_MONGODB_DATA_API_KEY=

# Ensure .env is in .gitignore and never commit real values.
